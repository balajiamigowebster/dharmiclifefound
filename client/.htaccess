<IfModule mod_rewrite.c>
  RewriteEngine On

  # Allow all direct file and directory requests
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other routes to index.html for React SPA
  RewriteRule . index.html [L]
</IfModule>

# Ensure correct MIME type for JS module scripts and styles
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

# Prevent 403 Forbidden on directory browsing
Options -Indexes +FollowSymLinks

# Allow access to web assets
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
