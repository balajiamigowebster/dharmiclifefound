{
  "name": "dharmic-life-foundation",
  "version": "1.0.0",
  "description": "Dharmic Life Foundation Full-Stack Website built with React.js, Node.js Express, and MariaDB",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run start --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client",
    "start": "node server/index.js",
    "db:init": "node server/init-mariadb.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "isomorphic-git": "^1.44.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
